PORT=3000
# TMDB "API Read Access Token": https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Telegram Mini App ---
# Token from @BotFather (never commit it)
BOT_TOKEN=
# Public HTTPS URL where this app is deployed (e.g. https://moviebox-miniapp.vercel.app)
WEBAPP_URL=
# Any long random string; Telegram sends it back so only Telegram can hit the webhook
WEBHOOK_SECRET=
# Set to 1 in production so /api/search only works when opened inside Telegram
REQUIRE_TELEGRAM=0
